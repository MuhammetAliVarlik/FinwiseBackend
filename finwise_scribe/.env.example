# Core runtime
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-db-password
POSTGRES_DB=finwise
DATABASE_URL=postgresql+asyncpg://postgres:change-this-db-password@db:5432/finwise

# Service wiring
SCRIBE_SERVICE_URL=http://scribe:8001
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# LLM service
OLLAMA_URL=http://ollama:11434
MLFLOW_TRACKING_URI=http://mlflow:5000
NEWS_RSS_TEMPLATE=https://news.google.com/rss/search?q={query}&hl=en-US&gl=US&ceid=US:en

# Monitoring
GF_SECURITY_ADMIN_PASSWORD=change-this-grafana-password

# Backend app
APP_SECRET_KEY=change-me-please-16chars-min
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://0.0.0.0:3000"]
DB_ECHO=false
MODEL_PATH=/app/ml_models/v1_adapter
